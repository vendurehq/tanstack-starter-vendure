# Vendure Shop API URL (required)
# Server-side only (recommended for security)
VENDURE_SHOP_API_URL=http://localhost:3000/shop-api

# Vendure Channel Token (optional, defaults to __default_channel__)
VENDURE_CHANNEL_TOKEN=__default_channel__

# Site URL for metadata/SEO (Vite public — available on client for head()/canonicals)
# Required for production builds outside Vercel. Vercel supplies its production URL automatically.
VITE_SITE_URL=http://localhost:3001
# Deprecated: SITE_URL / NEXT_PUBLIC_SITE_URL (no longer read)

# Cache Revalidation Secret (required for /api/revalidate endpoint)
# Generate a secure random string, e.g.: openssl rand -base64 32
# Optional at boot so local/dev without webhook still works
REVALIDATION_SECRET=your-secure-random-string-here

# Site Name for metadata/SEO (Vite public — available on client for head())
# Defaults to Vendure Store
VITE_SITE_NAME=Vendure Store
# Deprecated: SITE_NAME / NEXT_PUBLIC_SITE_NAME (no longer read)

# Vendure Auth Token Cookie Name (optional, defaults to vendure-auth-token)
# VENDURE_AUTH_TOKEN_COOKIE=vendure-auth-token

# Vendure Auth Token Header Name (optional, defaults to vendure-auth-token)
# VENDURE_AUTH_TOKEN_HEADER=vendure-auth-token

# Vendure Channel Token Header Name (optional, defaults to vendure-token)
# VENDURE_CHANNEL_TOKEN_HEADER=vendure-token
